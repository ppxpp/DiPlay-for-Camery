<resources>
    <string name="settings_camry_apps_title">車機應用程式管理</string>
    <string name="settings_camry_apps_description">以下應用程式在背景執行時可能佔用較多資源，導致 CarPlay 畫面或音訊卡頓。不使用時可將其停用。停用後重新啟動仍生效，可隨時恢復，不會刪除應用程式資料。</string>
    <string name="settings_camry_apps_amap">停用高德地圖</string>
    <string name="settings_camry_apps_amap_description">停止車機高德地圖執行，不影響 iPhone 上的高德地圖。</string>
    <string name="settings_camry_apps_tencent_map">停用騰訊地圖</string>
    <string name="settings_camry_apps_tencent_map_description">停止車機騰訊地圖執行，不影響 iPhone 上的騰訊地圖。</string>
    <string name="settings_camry_apps_tencent_speech">停用騰訊語音</string>
    <string name="settings_camry_apps_tencent_speech_description">停止車機騰訊語音執行，可能影響原車語音喚醒和語音控制。</string>
