    <string name="settings_camry_apps_tencent_map_description">Stop Tencent Maps on the head unit. Tencent Maps on the iPhone is unaffected.</string>
    <string name="settings_camry_apps_tencent_speech">Disable Tencent Voice</string>
    <string name="settings_camry_apps_tencent_speech_description">Stop Tencent Voice on the head unit. Factory voice wake-up and voice controls may be affected.</string>
