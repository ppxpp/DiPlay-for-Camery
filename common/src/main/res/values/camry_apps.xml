    <string name="settings_camry_apps_title">Vehicle app management</string>
    <string name="settings_camry_apps_description">These apps may use substantial resources in the background, causing CarPlay video or audio stutter. Disable them when not needed. Disabling persists after a restart and can be reversed without deleting app data.</string>
