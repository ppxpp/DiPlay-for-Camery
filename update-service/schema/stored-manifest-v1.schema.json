{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/stored-manifest-v1.json",
  "title": "Stored release manifest v1",
  "type": "object",
  "required": ["schemaVersion", "version", "versionCode", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "version": { "type": "string", "minLength": 1 },
    "versionName": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 0 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "mandatory": { "type": "boolean" },
    "notesUrl": { "type": "string", "format": "uri" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "key", "checksumsKey"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "arch": { "type": "string", "minLength": 1 },
          "key": { "type": "string", "minLength": 1 },
          "checksumsKey": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
