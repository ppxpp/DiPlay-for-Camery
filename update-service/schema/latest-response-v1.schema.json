{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schema/latest-response-v1.json",
  "title": "Latest release response v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "appId",
    "platform",
    "channel",
    "version",
    "versionCode",
    "mandatory",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "appId": { "type": "string", "minLength": 1 },
    "platform": { "type": "string", "minLength": 1 },
    "channel": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "versionName": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 0 },
    "publishedAt": { "type": "string", "format": "date-time" },
    "mandatory": { "type": "boolean" },
    "notesUrl": { "type": "string", "format": "uri" },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "url", "checksumsUrl"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "arch": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" },
          "checksumsUrl": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
