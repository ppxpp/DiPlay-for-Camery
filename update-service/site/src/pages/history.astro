---
import '../styles/global.css';
import ReleaseHistory from '../components/ReleaseHistory.vue';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site.ts';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>历史版本 · {site.shortName}</title>
    <meta name="description" content="DiPlay 凯美瑞版历史版本，可按正式版或内测版筛选下载。" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/app-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <SiteHeader current="history" />

    <main class="shell page-shell">
      <div class="page-frame">
        <div class="page-head">
          <nav class="breadcrumb" aria-label="面包屑">
            <a href="/">首页</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">历史版本</span>
          </nav>
          <span class="eyebrow">
            <span class="eyebrow-dot" aria-hidden="true"></span>
            版本归档
          </span>
          <h1>历史版本</h1>
          <p class="page-lead">已发布版本长期保留，可按正式版或内测版筛选下载。</p>
        </div>

        <ReleaseHistory client:load />
      </div>
    </main>

    <SiteFooter />
  </body>
</html>
