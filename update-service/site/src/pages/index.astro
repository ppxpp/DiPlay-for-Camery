---
import '../styles/global.css';
import Analytics from '../components/Analytics.astro';
import DocsLinks from '../components/DocsLinks.astro';
import Hero from '../components/Hero.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site.ts';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      name: site.name,
      alternateName: site.shortName,
      url: 'https://diplay.mgulu.com/',
      inLanguage: 'zh-CN',
    },
    {
      '@type': 'SoftwareApplication',
      name: site.name,
      alternateName: site.shortName,
      description: site.intro,
      url: 'https://diplay.mgulu.com/',
      applicationCategory: 'MultimediaApplication',
      operatingSystem: 'Android',
      inLanguage: 'zh-CN',
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    },
  ],
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="applicable-device" content="pc,mobile" />
    <meta name="color-scheme" content="light" />
    <title>{site.name}</title>
    <meta name="description" content={site.intro} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/app-icon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.shortName} />
    <meta property="og:title" content={site.name} />
    <meta property="og:description" content={site.intro} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:url" content="https://diplay.mgulu.com/" />
    <meta property="og:image" content="https://diplay.mgulu.com/app-icon.png" />
    <meta property="og:image:alt" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={site.name} />
    <meta name="twitter:description" content={site.intro} />
    <link rel="canonical" href="https://diplay.mgulu.com/" />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
    <Analytics />
  </head>
  <body>
    <SiteHeader current="home" />

    <main class="shell">
      <Hero />

      <section id="docs" class="docs-section" aria-labelledby="docs-title" tabindex="-1">
        <div class="section-head docs-head">
          <div class="docs-title-row">
            <h2 id="docs-title">文档</h2>
            {
              site.docs.index ? (
                <a class="docs-all" href={site.docs.index} target="_blank" rel="noopener">
                  查看全部文档
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path
                      d="M4.5 11.5 11.5 4.5M11.5 4.5H6M11.5 4.5V10"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>
              ) : (
                <span class="docs-all is-pending" aria-disabled="true">
                  查看全部文档 <span class="tag">待发布</span>
                </span>
              )
            }
          </div>
          <p>安装步骤、功能说明与已知问题都在飞书文档中维护，会随版本持续更新。</p>
        </div>
        <DocsLinks />
      </section>

      <section id="before" class="notice-section" aria-labelledby="before-title" tabindex="-1">
        <div class="section-head">
          <h2 id="before-title">试用前请了解</h2>
          <p>请在你自己拥有的车机上使用，并在停车状态下完成安装与测试。</p>
        </div>
        <div class="cols two">
          <div class="card">
            <h3 class="card-title">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M12 3.5 5.5 6v5.5c0 4.1 2.7 7.2 6.5 8.5 3.8-1.3 6.5-4.4 6.5-8.5V6L12 3.5Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
                <path
                  d="M12 8.5v4.2m0 2.4v.3"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                />
              </svg>
              许可与风险
            </h3>
            <ul class="plain">
              {
                site.limits.map((item) => (
                  <li>{item}</li>
                ))
              }
            </ul>
          </div>
          <div class="card">
            <h3 class="card-title">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path
                  d="M4.5 5.5h15v9.5h-8l-4 3v-3h-3V5.5Z"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linejoin="round"
                />
              </svg>
              反馈与环境信息
            </h3>
            <p>
              反馈时请注明车机固件版本、iPhone 与 iOS 版本、连接方式（无线 / 有线）、相关设置、复现步骤与故障时间，并附上应用内导出的诊断报告。
            </p>
            {
              site.feedbackUrl ? (
                <a class="btn secondary" href={site.feedbackUrl} target="_blank" rel="noopener">
                  问题反馈
                </a>
              ) : (
                <p class="muted-note">反馈渠道待公布。</p>
              )
            }
          </div>
        </div>
      </section>
    </main>

    <SiteFooter />
  </body>
</html>
