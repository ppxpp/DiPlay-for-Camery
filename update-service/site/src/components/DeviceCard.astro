---
import { site } from '../data/site.ts';
---

<aside class="device-card" aria-labelledby="device-title">
  <div class="device-head">
    <div>
      <h2 id="device-title">适配设备</h2>
      <p class="device-desc">本项目按这台车机的固件做适配与验证，不承诺覆盖其他主机。</p>
    </div>
    <span class="device-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M4.5 14.5 6 9.2A2 2 0 0 1 7.9 7.8h8.2a2 2 0 0 1 1.9 1.4l1.5 5.3"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M4 14.5h16v3.8a1 1 0 0 1-1 1h-.8a1 1 0 0 1-1-1v-.6H6.8v.6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3.8Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path d="M7 16.6h.01M17 16.6h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </span>
  </div>

  <dl class="spec">
    <dt>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M3.25 11.25 4.4 7.6a1.75 1.75 0 0 1 1.66-1.2h7.88a1.75 1.75 0 0 1 1.66 1.2l1.15 3.65"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M3 11.25h18v4.1a.9.9 0 0 1-.9.9h-.9a.9.9 0 0 1-.9-.9v-.6H5.7v.6a.9.9 0 0 1-.9.9h-.9a.9.9 0 0 1-.9-.9v-4.1Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path d="M7 14h.01M17 14h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      车机
    </dt>
    <dd>{site.device.model}</dd>
    <dt>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M6 3.5h7l5 5v12H6v-17Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path
          d="M13 3.5v5h5M9 12h6M9 15h6"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      已验证版本
    </dt>
    <dd>{site.device.verifiedFirmware}</dd>
    <dt>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path
          d="M9.5 14.5 7 17a3 3 0 0 1-4.24-4.24L5.5 10m9-4.5L17 7a3 3 0 0 1 4.24 4.24L18.5 14M8 12h8"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      连接方式
    </dt>
    <dd>{site.device.connection}</dd>
  </dl>

  <div class="warning">
    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <circle cx="10" cy="10" r="8" fill="currentColor" />
      <path d="M10 5.7v4.9" stroke="#fff" stroke-width="1.8" stroke-linecap="round" />
      <circle cx="10" cy="14.1" r="1.05" fill="#fff" />
    </svg>
    <div>
      <strong>支持范围</strong>
      <p>{site.scope}</p>
    </div>
  </div>
</aside>
