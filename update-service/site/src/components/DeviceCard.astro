---
import { site } from '../data/site.ts';
---

<aside class="device-card" aria-labelledby="device-title">
  <div class="device-head">
    <div>
      <h2 id="device-title">适配设备</h2>
      <p class="device-desc">专为八代凯美瑞先锋 A 导航车机适配，在原车操作习惯上补齐 CarPlay 的连接、声音与按键体验。</p>
    </div>
    <span class="device-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path
          d="M4.5 14.5 6 9.2A2 2 0 0 1 7.9 7.8h8.2a2 2 0 0 1 1.9 1.4l1.5 5.3"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <path
          d="M4 14.5h16v3.8a1 1 0 0 1-1 1h-.8a1 1 0 0 1-1-1v-.6H6.8v.6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3.8Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        />
        <path d="M7 16.6h.01M17 16.6h.01" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
      </svg>
    </span>
  </div>

  <div class="device-highlights">
    <h3 class="highlights-title">适配版亮点</h3>
    <ul>
      {
        site.highlights.map((item) => (
          <li>{item}</li>
        ))
      }
    </ul>
  </div>

  <p class="compat-note">{site.compatibilityNote}</p>
</aside>
