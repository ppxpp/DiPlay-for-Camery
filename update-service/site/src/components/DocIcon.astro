---
interface Props {
  name: 'book' | 'features' | 'alert';
}

const { name } = Astro.props;
---

{
  name === 'book' ? (
    <svg viewBox="0 0 24 24" fill="none">
      <path
        d="M4.5 5.5h5A2.5 2.5 0 0 1 12 8v10.5a2.5 2.5 0 0 0-2.5-2.5h-5V5.5Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
      <path
        d="M19.5 5.5h-5A2.5 2.5 0 0 0 12 8v10.5a2.5 2.5 0 0 1 2.5-2.5h5V5.5Z"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"
      />
    </svg>
  ) : name === 'features' ? (
    <svg viewBox="0 0 24 24" fill="none">
      <path
        d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2Z"
        stroke="currentColor"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" />
    </svg>
  ) : (
    <svg viewBox="0 0 24 24" fill="none">
      <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5" />
      <path
        d="M9.7 9.3a2.4 2.4 0 1 1 4 1.75c-.85.72-1.7 1.35-1.7 2.75"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
      />
      <path d="M12 16.4v.3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
    </svg>
  )
}
