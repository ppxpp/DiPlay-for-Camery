---
import { site } from '../data/site.ts';
import { fetchUpdateChannel } from '../data/updates.ts';
import DeviceCard from './DeviceCard.astro';
import DownloadPanel from './DownloadPanel.vue';

const [initialStable, initialBeta] = await Promise.all([
  fetchUpdateChannel('stable'),
  fetchUpdateChannel('beta'),
]);

const heroBrand = site.name.split(' ')[0];
const heroModel = site.shortName.replace(/^DiPlay\s+/, '');
const heroVariant = site.name.split(' ').slice(2).join(' ');
---

<section class="hero-section" aria-labelledby="hero-title">
  <div class="hero">
    <div class="hero-copy">
      <span class="eyebrow">
        <span class="eyebrow-dot" aria-hidden="true"></span>
        社区适配版
      </span>
      <h1 id="hero-title"><span class="brand-word">{heroBrand}</span>{' '}{heroModel}<br />{heroVariant}</h1>
      <p class="intro">{site.intro}</p>
      <DownloadPanel client:load initialStable={initialStable} initialBeta={initialBeta} />
    </div>
    <DeviceCard />
  </div>
</section>
